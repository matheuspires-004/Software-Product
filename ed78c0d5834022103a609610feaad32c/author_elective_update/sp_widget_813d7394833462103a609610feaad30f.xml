        <template><![CDATA[<div class="carousel-container">
  <div class="carousel-slides">
    <div class="carousel-slide" 
         ng-repeat="slide in data.slides" 
         ng-show="$index === currentIndex || $index === currentIndex + 1">
      <img ng-src="{{slide.image}}" alt="{{slide.title}}" class="carousel-img" />
      <div class="carousel-caption">
        <h3>{{slide.title}}</h3>
        <p>{{slide.description}}</p>
      </div>
    </div>
  </div>

  <div class="carousel-controls">
    <button class="carousel-btn" ng-click="prevSlide()">❮</button>
    <button class="carousel-btn" ng-click="nextSlide()">❯</button>
  </div>
</div>
]]></template>
